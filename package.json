{
  "name": "ys-fitness",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings 0 && turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter api test:e2e",
    "test:affected": "node scripts/run-affected-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "typecheck:staged": "node scripts/run-staged-typecheck.mjs",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "docker:up": "docker compose up -d --wait postgres",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d --wait postgres",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:seed": "pnpm --filter api prisma:seed"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "pnpm": "10.17.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  }
}
