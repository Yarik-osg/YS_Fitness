# Public REST API base URL embedded in browser bundles. Never place secrets here.
# Local default talks to Nest directly. For one ngrok tunnel (free plan), use the
# Next rewrite instead and restart the web dev server:
# NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Optional override for the rewrite target in next.config.js (default below).
# API_PROXY_TARGET=http://localhost:3001
# Canonical public web URL used for redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
