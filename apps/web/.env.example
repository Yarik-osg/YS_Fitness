# Public REST API base URL embedded in browser bundles. Never place secrets here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# Must match API REFRESH_COOKIE_NAME so cross-site CSRF forwarding can find its
# readable companion cookie when SameSite=None is enabled.
NEXT_PUBLIC_REFRESH_COOKIE_NAME=ys_refresh

# Canonical public web URL used for redirects and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
