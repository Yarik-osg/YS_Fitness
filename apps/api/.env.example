# Runtime mode controls secure-cookie and error behavior.
NODE_ENV=development
# HTTP port for the NestJS API.
PORT=3001
# PostgreSQL connection used by Prisma at runtime.
DATABASE_URL=postgresql://ys_fitness:ys_fitness_dev@localhost:5432/ys_fitness?schema=public
# Separate migrated database for API e2e tests (can match DATABASE_URL locally).
TEST_DATABASE_URL=postgresql://ys_fitness:ys_fitness_dev@localhost:5432/ys_fitness_test?schema=public
# Independent signing secrets; replace with random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
# Access-token lifetime in seconds and refresh-session lifetime in days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Comma-separated browser origins allowed by CORS and CSRF origin checks.
# Keep the localhost entry. For one ngrok tunnel on the web port, append that
# origin (no trailing slash) and restart the API:
# WEB_ORIGINS=http://localhost:3000,https://web-example.ngrok-free.dev
WEB_ORIGINS=http://localhost:3000
# Browser refresh-cookie name and SameSite policy (strict, lax, or none).
REFRESH_COOKIE_NAME=ys_refresh
# Local and same-origin ngrok (Next rewrite) stay lax. Only set none when the
# browser talks to a different API host; none already marks cookies Secure.
# There is no separate COOKIE_SECURE variable. In none mode the auth JSON
# includes csrfToken and the page stores it itself.
COOKIE_SAME_SITE=lax
# Signs double-submit CSRF tokens when COOKIE_SAME_SITE=none.
CSRF_SECRET=replace-with-a-different-32-character-secret
# Outgoing mail. Leave SMTP_HOST empty to disable email. Locally, Mailpit
# (pnpm docker:up) catches everything; open http://localhost:8025 to read it.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Set SMTP_USER/SMTP_PASSWORD (and SMTP_SECURE=true for port 465) for a real provider.
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
MAIL_FROM="YS Fitness <no-reply@localhost>"
# Base URL for links in emails. Defaults to the first WEB_ORIGINS entry.
# APP_URL=http://localhost:3000
# Explicit pnpm db:seed credentials; never used during application startup.
SEED_TRAINER_EMAIL=trainer@example.com
SEED_TRAINER_PASSWORD=replace-with-a-strong-password
