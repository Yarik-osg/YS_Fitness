# Runtime mode controls secure-cookie and error behavior.
NODE_ENV=development
# HTTP port for the NestJS API.
PORT=3001
# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://ys_fitness:ys_fitness_dev@localhost:5432/ys_fitness?schema=public
# Independent signing secrets; replace with random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
# Access-token lifetime in seconds and refresh-session lifetime in days.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Comma-separated browser origins allowed by CORS and CSRF origin checks.
WEB_ORIGINS=http://localhost:3000
# Browser refresh-cookie name and SameSite policy (strict, lax, or none).
REFRESH_COOKIE_NAME=ys_refresh
COOKIE_SAME_SITE=lax
# Signs double-submit CSRF tokens when COOKIE_SAME_SITE=none.
CSRF_SECRET=replace-with-a-different-32-character-secret
# Explicit pnpm db:seed credentials; never used during application startup.
SEED_TRAINER_EMAIL=trainer@example.com
SEED_TRAINER_PASSWORD=replace-with-a-strong-password
