generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADMIN
}

enum BiologicalSexForCalculation {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum FitnessGoal {
  LOSE_WEIGHT
  MAINTAIN_WEIGHT
  GAIN_WEIGHT
}

enum ProgramTrack {
  FEMALE
  MALE
}

enum OnboardingMainGoal {
  LOSE_WEIGHT
  BUILD_MUSCLE
  IMPROVE_BODY
  MAINTAIN
  GET_STRONGER
}

enum TrainingExperience {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum NutritionCurrent {
  STRUCTURED
  BALANCED
  INTUITIVE
  IRREGULAR
  UNCONTROLLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @map("password_hash")
  role         UserRole @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  /// Private coach note. Null when empty. Clients never receive this column.
  coachNote    String?  @map("coach_note") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  profile              UserProfile?
  onboardingResponses  OnboardingResponses?
  bodyMeasurements     BodyMeasurement[]
  authSessions         AuthSession[]
  passwordResetTokens  PasswordResetToken[]
  subscriptions        Subscription[]
  grantedSubscriptions Subscription[]       @relation("GrantedSubscriptions")
  workoutProgram       WorkoutProgram?
  workoutLogs           WorkoutLog[]
  progressPhotos        ProgressPhoto[]
  ownedProgramTemplates ProgramTemplate[]
  nutritionProfile      NutritionProfile?
  nutritionCalculations NutritionCalculation[]
  nutritionTargets      NutritionTarget[]
  foodProducts          FoodProduct[]
  favoriteFoods         FavoriteFood[]
  foodLogEntries        FoodLogEntry[]

  @@map("users")
}

model UserProfile {
  id                          String                      @id @default(uuid()) @db.Uuid
  userId                      String                      @unique @map("user_id") @db.Uuid
  name                        String?                     @db.VarChar(40)
  dateOfBirth                 DateTime                    @map("date_of_birth") @db.Date
  biologicalSexForCalculation BiologicalSexForCalculation @map("biological_sex_for_calculation")
  heightCm                    Decimal                     @map("height_cm") @db.Decimal(5, 2)
  activityLevel               ActivityLevel               @map("activity_level")
  /// Current goal only. Goal history is intentionally deferred to a future tracked-history model.
  goal                        FitnessGoal
  healthRestrictions          Json?                       @map("health_restrictions")
  timezone                    String                      @default("UTC") @db.VarChar(100)
  onboardingCompletedAt       DateTime?                   @map("onboarding_completed_at")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model OnboardingResponses {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @unique @map("user_id") @db.Uuid
  programTrack      ProgramTrack       @map("program_track")
  currentBody       String             @map("current_body") @db.VarChar(32)
  desiredBody       String             @map("desired_body") @db.VarChar(8)
  mainGoal          OnboardingMainGoal @map("main_goal")
  experience        TrainingExperience
  trainingFrequency String             @map("training_frequency") @db.VarChar(8)
  focusAreas        String[]           @map("focus_areas")
  nutritionCurrent  NutritionCurrent   @map("nutrition_current")
  mealsPerDay       String             @map("meals_per_day") @db.VarChar(16)
  eatingHabits      String[]           @map("eating_habits")
  physiqueLevel     String?            @map("physique_level") @db.VarChar(2)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_responses")
}

model ProgressPhoto {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  contentType String   @map("content_type") @db.VarChar(32)
  storageKey  String   @unique @map("storage_key") @db.VarChar(96)
  width       Int
  height      Int
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("progress_photos")
}

model BodyMeasurement {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  weightKg       Decimal  @map("weight_kg") @db.Decimal(6, 2)
  bodyFatPercent Decimal? @map("body_fat_percent") @db.Decimal(5, 2)
  measuredAt     DateTime @default(now()) @map("measured_at")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt(sort: Desc)])
  @@map("body_measurements")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  deviceName String?   @map("device_name") @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model AuthRefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt(sort: Desc)])
  @@map("auth_refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the emailed token; the raw token is never stored.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  MOCK
  MANUAL
  WAYFORPAY
}

model Plan {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(120)
  priceAmount    Int      @map("price_amount")
  currency       String   @default("UAH") @db.VarChar(3)
  intervalMonths Int      @map("interval_months")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  status            SubscriptionStatus
  provider          PaymentProvider
  providerReference String?            @map("provider_reference") @db.VarChar(255)
  pendingPlanId     String?            @map("pending_plan_id") @db.Uuid
  currentPeriodEnd  DateTime?          @map("current_period_end")
  grantedByUserId   String?            @map("granted_by_user_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan  @relation(fields: [planId], references: [id])
  grantedBy User? @relation("GrantedSubscriptions", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  // The partial unique index subscription_one_active_per_user (one PENDING or
  // ACTIVE row per user) lives only in the add_plans_and_subscriptions
  // migration SQL. `prisma db push` and schema-only rebuilds drop it; apply
  // schema changes with `prisma migrate`. SubscriptionIndexCheck refuses to
  // boot the API without it.
  @@map("subscriptions")
}

enum MuscleGroup {
  GLUTES
  QUADRICEPS
  HAMSTRINGS
  BACK
  BICEPS
  TRICEPS
  CHEST
  SHOULDERS
  ABS
  REAR_DELTOIDS
  CALVES
}

enum ProgramAccent {
  NONE
  UPPER
  LOWER
  BACK
  CHEST
  SHOULDERS
  ARMS
  LEGS
}

enum ProgramOrigin {
  SYSTEM
  TRAINER
}

enum AssignmentSource {
  MATCHED
  ADMIN
}

model Exercise {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(16)
  name         String        @db.VarChar(200)
  nameEn       String        @default("") @map("name_en") @db.VarChar(200)
  muscleGroups MuscleGroup[] @map("muscle_groups")
  repsMin      Int           @map("reps_min")
  repsMax      Int           @map("reps_max")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  templateExercises ProgramTemplateExercise[]
  workoutLogSets    WorkoutLogSet[]

  @@map("exercises")
}

model ProgramTemplate {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique @db.VarChar(16)
  name             String             @db.VarChar(200)
  gender           ProgramTrack
  level            TrainingExperience
  frequencyPerWeek Int                @map("frequency_per_week")
  accent           ProgramAccent
  origin           ProgramOrigin      @default(SYSTEM)
  /// Null for SYSTEM templates. Required for TRAINER templates by
  /// program_templates_owner_origin_check, which lives only in the migration
  /// SQL. The partial unique index program_templates_identity_key (one system
  /// row per gender, level, frequency, and accent) is also SQL-only.
  /// `prisma db push` and schema-only rebuilds drop both; apply schema
  /// changes with `prisma migrate`. A later `migrate dev` may emit
  /// DROP INDEX program_templates_identity_key or DROP CONSTRAINT
  /// program_templates_owner_origin_check because Prisma cannot model them.
  /// Delete those statements. ProgramTemplateConstraintCheck refuses to boot
  /// without them, and the migration spec fails if a later file drops them.
  ownerId          String?            @map("owner_id") @db.Uuid
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  days            ProgramTemplateDay[]
  workoutPrograms WorkoutProgram[]
  workoutLogs     WorkoutLog[]
  owner           User?                @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@map("program_templates")
}

model ProgramTemplateDay {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  dayNumber  Int    @map("day_number")

  template  ProgramTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercises ProgramTemplateExercise[]

  @@unique([templateId, dayNumber])
  @@map("program_template_days")
}

model ProgramTemplateExercise {
  id             String  @id @default(uuid()) @db.Uuid
  templateDayId  String  @map("template_day_id") @db.Uuid
  exerciseId     String  @map("exercise_id") @db.Uuid
  order          Int
  sets           Int
  repsMin        Int     @map("reps_min")
  repsMax        Int     @map("reps_max")
  allowsAbsAddon Boolean @default(false) @map("allows_abs_addon")

  templateDay ProgramTemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  exercise    Exercise           @relation(fields: [exerciseId], references: [id])

  @@unique([templateDayId, order])
  @@map("program_template_exercises")
}

model WorkoutProgram {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @unique @map("user_id") @db.Uuid
  templateId       String           @map("template_id") @db.Uuid
  assignedAt       DateTime         @default(now()) @map("assigned_at")
  assignmentSource AssignmentSource @default(MATCHED) @map("assignment_source")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template ProgramTemplate @relation(fields: [templateId], references: [id])

  @@map("workout_programs")
}

model WorkoutLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  /// Null after the program is deleted. The name and code below keep history readable.
  templateId   String?  @map("template_id") @db.Uuid
  templateCode String?  @map("template_code") @db.VarChar(16)
  templateName String?  @map("template_name") @db.VarChar(200)
  dayNumber    Int      @map("day_number")
  completedAt  DateTime @default(now()) @map("completed_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template ProgramTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sets     WorkoutLogSet[]

  @@index([userId, completedAt])
  @@map("workout_logs")
}

model WorkoutLogSet {
  id            String   @id @default(uuid()) @db.Uuid
  workoutLogId  String   @map("workout_log_id") @db.Uuid
  exerciseId    String   @map("exercise_id") @db.Uuid
  order         Int
  setNumber     Int      @map("set_number")
  repsCompleted Int      @map("reps_completed")
  weightKg      Decimal? @map("weight_kg") @db.Decimal(6, 2)
  /// The program's rep range at the time the program was deleted.
  /// Null while the program still exists; the template day is used instead.
  prescribedRepsMin Int? @map("prescribed_reps_min")
  prescribedRepsMax Int? @map("prescribed_reps_max")

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutLogId, order, setNumber])
  @@map("workout_log_sets")
}

/// Formula inputs chosen on the nutrition screen. Not the training activity slider or training goal.
enum NutritionActivity {
  SEDENTARY
  MODERATE
  HIGH
  VERY_HIGH
}

enum NutritionGoal {
  LOSE_WEIGHT
  MAINTAIN
  GAIN_MUSCLE
  RECOMPOSITION
}

enum NutritionTargetSource {
  CALCULATED
  MANUAL
}

enum NutritionCalculationStatus {
  VALID
  REQUIRES_REVIEW
}

enum NutritionReviewReason {
  NEGATIVE_CARBS
  LOW_CALORIES
  EXCESSIVE_PROTEIN_RATIO
  EXCESSIVE_FAT_RATIO
  UNUSUAL_BODY_WEIGHT
  UNDERAGE
}

model NutritionProfile {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  activity    NutritionActivity
  goal        NutritionGoal
  preferences String?           @db.VarChar(500)
  allergies   String?           @db.VarChar(500)
  dislikes    String?           @db.VarChar(500)
  mealCount   Int               @map("meal_count")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_profiles")
}

model NutritionCalculation {
  id                 String                      @id @default(uuid()) @db.Uuid
  userId             String                      @map("user_id") @db.Uuid
  weightKg           Decimal                     @map("weight_kg") @db.Decimal(6, 2)
  heightCm           Decimal                     @map("height_cm") @db.Decimal(5, 2)
  ageYears           Int                         @map("age_years")
  sex                BiologicalSexForCalculation
  activity           NutritionActivity
  frequency          Int
  goal               NutritionGoal
  activityMultiplier Decimal                     @map("activity_multiplier") @db.Decimal(4, 2)
  goalAdjustment     Decimal                     @map("goal_adjustment") @db.Decimal(6, 3)
  bmr                Decimal                     @db.Decimal(24, 12)
  tdee               Decimal                     @db.Decimal(24, 12)
  targetCalories     Decimal                     @map("target_calories") @db.Decimal(24, 12)
  proteinGrams       Decimal                     @map("protein_grams") @db.Decimal(24, 12)
  fatGrams           Decimal                     @map("fat_grams") @db.Decimal(24, 12)
  carbsGrams         Decimal                     @map("carbs_grams") @db.Decimal(24, 12)
  carbsNonPositive   Boolean                     @map("carbs_non_positive")
  status             NutritionCalculationStatus  @default(VALID)
  reviewReasons      NutritionReviewReason[]     @default([]) @map("review_reasons")
  displayCalories    Int                         @map("display_calories")
  displayProteinGrams Int                        @map("display_protein_grams")
  displayFatGrams    Int                         @map("display_fat_grams")
  displayCarbsGrams  Int                         @map("display_carbs_grams")
  createdAt          DateTime                    @default(now()) @map("created_at")

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets NutritionTarget[]

  @@index([userId, createdAt])
  @@map("nutrition_calculations")
}

model NutritionTarget {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  /// Append-only. A new calculated norm deactivates the previous active row
  /// and inserts another. Only that active flag changes. A manual row stays.
  /// One active row per user is the partial unique index
  /// nutrition_one_active_target (user_id WHERE active), hand-written in the
  /// nutrition migration because Prisma cannot model that predicate.
  /// NutritionIndexCheck refuses to boot unless that exact index is present.
  active         Boolean               @default(false)
  source         NutritionTargetSource
  calculationId  String?               @map("calculation_id") @db.Uuid
  targetCalories Decimal               @map("target_calories") @db.Decimal(24, 12)
  proteinGrams   Decimal               @map("protein_grams") @db.Decimal(24, 12)
  fatGrams       Decimal               @map("fat_grams") @db.Decimal(24, 12)
  carbsGrams     Decimal               @map("carbs_grams") @db.Decimal(24, 12)
  createdAt      DateTime              @default(now()) @map("created_at")

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  calculation NutritionCalculation? @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("nutrition_targets")
}

enum FoodProductSource {
  OFF
  CUSTOM
}

enum FoodMeal {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// Cached Open Food Facts row or a product the user typed in.
/// An OFF row is never edited from a log. A personal copy is a new CUSTOM row.
model FoodProduct {
  id               String            @id @default(uuid()) @db.Uuid
  source           FoodProductSource
  externalId       String?           @map("external_id") @db.VarChar(32)
  ownerId          String?           @map("owner_id") @db.Uuid
  basedOnProductId String?           @map("based_on_product_id") @db.Uuid
  name             String            @db.VarChar(200)
  brand            String?           @db.VarChar(200)
  imageUrl         String?           @map("image_url") @db.VarChar(2000)
  kcalPer100g      Decimal           @map("kcal_per_100g") @db.Decimal(7, 2)
  proteinPer100g   Decimal           @map("protein_per_100g") @db.Decimal(7, 2)
  fatPer100g       Decimal           @map("fat_per_100g") @db.Decimal(7, 2)
  carbsPer100g     Decimal           @map("carbs_per_100g") @db.Decimal(7, 2)
  createdAt        DateTime          @default(now()) @map("created_at")

  owner      User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  basedOn    FoodProduct?   @relation("FoodProductOrigin", fields: [basedOnProductId], references: [id], onDelete: SetNull)
  copies     FoodProduct[]  @relation("FoodProductOrigin")
  favorites  FavoriteFood[]
  logEntries FoodLogEntry[]

  @@unique([source, externalId])
  @@index([ownerId])
  @@map("food_products")
}

model FavoriteFood {
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  product FoodProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@map("favorite_foods")
}

/// Snapshot on the entry is the history. It stays after the product changes or goes away.
model FoodLogEntry {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  productId   String?   @map("product_id") @db.Uuid
  loggedOn    DateTime  @map("logged_on") @db.Date
  meal        FoodMeal
  grams       Decimal   @db.Decimal(7, 1)
  productName String    @map("product_name") @db.VarChar(200)
  imageUrl    String?   @map("image_url") @db.VarChar(2000)
  kcal        Decimal   @db.Decimal(7, 1)
  protein     Decimal   @db.Decimal(7, 1)
  fat         Decimal   @db.Decimal(7, 1)
  carbs       Decimal   @db.Decimal(7, 1)
  createdAt   DateTime  @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product FoodProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, loggedOn])
  @@index([userId, productId, createdAt(sort: Desc)])
  @@map("food_log_entries")
}

/// One row per normalized text search that Open Food Facts answered.
/// A fresh row means the next search can stay on the local cache.
model FoodSearchQuery {
  queryKey  String   @id @map("query_key") @db.VarChar(100)
  fetchedAt DateTime @map("fetched_at")

  @@map("food_search_queries")
}
