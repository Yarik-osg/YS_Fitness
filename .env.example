# Local PostgreSQL container database name.
POSTGRES_DB=ys_fitness

# Local PostgreSQL container user.
POSTGRES_USER=ys_fitness

# Local-only password. Use a secret manager and a strong password outside development.
POSTGRES_PASSWORD=ys_fitness_dev

# Host port mapped to PostgreSQL's container port 5432.
POSTGRES_PORT=5432

# Host ports for the local Mailpit mail catcher (SMTP and web inbox).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
